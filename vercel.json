{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/webhook/sentry",
      "destination": "/api/webhook"
    },
    {
      "source": "/sentry-webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
